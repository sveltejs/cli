{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"vite.config.ts",
		".svelte-kit/ambient.d.ts",
		".svelte-kit/env.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		".svelte-kit/non-ambient.d.ts"
	],
	"exclude": ["node_modules", ".svelte-kit/output"]
}
