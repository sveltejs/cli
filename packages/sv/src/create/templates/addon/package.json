{
	"name": "$SV-NAME-TODO$",
	"version": "0.0.1",
	"description": "sv add-on for $SV-NAME-TODO$",
	"keywords": [
		"sv-add",
		"svelte",
		"sveltekit"
	],
	"license": "MIT",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"default": "./dist/index.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"demo-create": "sv create demo --types ts --template minimal --no-add-ons --no-install",
		"demo-add": "pnpm build && sv add file:../ --cwd demo --no-git-check --no-install",
		"demo-add:ci": "pnpm build && sv add file:../=who:you --cwd demo --no-git-check --no-download-check --no-install",
		"build": "tsdown",
		"prepublishOnly": "npm run build",
		"test": "vitest run"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/sv-utils": "workspace:*",
		"@types/node": "^25.9.1",
		"sv": "workspace:*",
		"tsdown": "^0.22.1",
		"vitest": "^4.1.8"
	},
	"peerDependencies": {
		"sv": "workspace:*"
	}
}
