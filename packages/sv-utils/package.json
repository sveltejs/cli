				"types": "./dist/browser.d.mts",
				"default": "./dist/browser.mjs"
			}
		}
	},
	"scripts": {
		"check": "tsgo"
	},
	"devDependencies": {
		"@types/estree": "^1.0.10",
		"decircular": "^1.0.0",
		"dedent": "^1.7.2",
		"diff": "^9.0.0",
		"esrap": "^2.4.0",
		"package-manager-detector": "^1.9.0",
		"silver-fleece": "^1.2.1",
		"smol-toml": "^1.9.1",
		"svelte": "^5.57.3",
		"verkit": "^0.5.0",
