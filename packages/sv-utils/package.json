	"description": "Utility functions for sv",
	"keywords": [
		"sv",
		"svelte",
		"sveltekit"
	],
	"homepage": "https://svelte.dev",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sveltejs/cli.git",
		"directory": "packages/sv-utils"
	},
	"files": [
		"dist"
	],
	"type": "module",
