{
	"name": "sv-monorepo",
	"version": "0.0.1",
	"private": true,
	"description": "monorepo for sv and friends",
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"postbuild": "node scripts/generate-api-surface.js",
		"changeset:publish": "changeset publish",
		"check": "pnpm --parallel check",
		"dev": "tsdown -w & pnpm --parallel check -w & wait",
		"format": "oxfmt",
		"lint": "oxfmt --check && eslint --cache --cache-location node_modules/.eslintcache",
		"test": "vitest run --silent",
		"test:addons": "vitest run --silent --project=addons",
		"test:ci": "vitest run --silent --project=!addons",
		"test:ecosystem-ci": "vitest run --exclude='**/storybook/test.ts'",
		"test:ui": "vitest --ui",
		"update-deps": "node ./scripts/update-dependencies.js && pnpm update -r --latest --include-github-actions && pnpm format"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.0",
		"@changesets/cli": "^3.0.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/eslint-config": "^10.0.1",
		"@types/node": "^22.18.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/ui": "4.1.8",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"oxfmt": "^0.62.0",
		"sv": "workspace:*",
		"svelte": "^5.56.9",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "4.1.8"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.27.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^22.18.0",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@11.27.1+sha512-qB1MIbmwmksK6/kO9eUn1CYr3aMi0mCCl4y1SQI6xtnK/Jixn/+qXHHbQ4pl9wIk7beNcxEYeGH/lkgNHNyiPA=="
}
